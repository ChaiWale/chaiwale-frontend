# ==============================================================================
# CHAIWALE Public Customer Web Application - Environment Configuration
# Template File: frontend/.env.example
# ==============================================================================

# Production Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://chaiwale.co.in

# Central Authoritative Backend API Endpoint
NEXT_PUBLIC_BACKEND_URL=https://api.chaiwale.co.in

# Official Chaiwale WhatsApp Business Contact (digits only, e.g. 919310112564)
NEXT_PUBLIC_WHATSAPP_NUMBER=919310112564

# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# - ONLY browser-safe variables prefixed with NEXT_PUBLIC_ may be added here.
# - NEVER place SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, RESEND_API_KEY, 
#   or payment secrets inside frontend environment variables.
# - All database operations, billing math, and notifications are routed 
#   through the backend API.
# ------------------------------------------------------------------------------
